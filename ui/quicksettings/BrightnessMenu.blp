using Gtk 4.0;

template $BrightnessMenu: $PanelRow {

    Scale slider {
        hexpand: true;
        valign: center;
        draw-value: false;

        adjustment: Adjustment {
            lower: 0;
            upper: 100;
            step-increment: 10;
            page-increment: 10;
            value: bind template.value bidirectional;
        };

        marks [
            mark (0, bottom),
            mark (1, bottom),
            mark (10, bottom),
            mark (20, bottom),
            mark (30, bottom),
            mark (40, bottom),
            mark (50, bottom),
            mark (60, bottom),
            mark (70, bottom),
            mark (80, bottom),
            mark (90, bottom),
            mark (100, bottom)
        ]
    }
}
