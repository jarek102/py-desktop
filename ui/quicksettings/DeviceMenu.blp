using Gtk 4.0;

template $DeviceMenu: Box {
    Grid {
        styles [
            "menu-content",
            "power-grid",
        ]

        column-homogeneous: true;

        Button logout {
            name: "logout";
            tooltip-text: "Log Out";
            clicked => $logout_clicked();

            layout {
                row: 0;
                column: 2;
            }

            icon-name: "system-log-out-symbolic";
        }

        Button sleep {
            name: "sleep";
            tooltip-text: "Suspend";
            clicked => $sleep_clicked();

            layout {
                row: 0;
                column: 3;
            }

            icon-name: "system-suspend-symbolic";
        }

        Button reboot {
            name: "reboot";
            tooltip-text: "Reboot";
            clicked => $reboot_clicked();

            layout {
                row: 0;
                column: 4;
            }

            icon-name: "system-reboot-symbolic";
        }

        Button poweroff {
            name: "poweroff";
            tooltip-text: "Power Off";
            clicked => $poweroff_clicked();

            layout {
                row: 0;
                column: 5;
            }

            icon-name: "system-shutdown-symbolic";
        }

        ToggleButton dark_mode {
            name: "dark_mode";
            tooltip-text: "Theme";
            icon-name: "night-light-symbolic";
            active: bind template.is_dark_mode bidirectional;

            layout {
                row: 1;
                column: 2;
            }
        }

        ToggleButton power_saver {
            name: "power_saver";
            tooltip-text: "Power Saver";
            icon-name: "power-profile-power-saver-symbolic";
            active: bind template.power_saver_active;
            clicked => $power_saver_clicked();
            visible: bind template.power_profiles_visible;

            layout {
                row: 1;
                column: 3;
            }
        }

        ToggleButton balanced {
            name: "balanced";
            tooltip-text: "Balanced";
            icon-name: "power-profile-balanced-symbolic";
            active: bind template.balanced_active;
            clicked => $balanced_clicked();
            visible: bind template.power_profiles_visible;

            layout {
                row: 1;
                column: 4;
            }
        }

        ToggleButton performance {
            name: "performance";
            tooltip-text: "Performance";
            icon-name: "power-profile-performance-symbolic";
            active: bind template.performance_active;
            clicked => $performance_clicked();
            visible: bind template.power_profiles_visible;

            layout {
                row: 1;
                column: 5;
            }
        }

        $BrightnessMenu {
            layout {
                row: 2;
                column: 0;
                column-span: 6;
            }
        }

        $VolumeMenu audio_menu {
            layout {
                row: 3;
                column: 0;
                column-span: 6;
            }
        }

        $VolumeMenu mic_menu {
            layout {
                row: 4;
                column: 0;
                column-span: 6;
            }
        }

        $BluetoothMenu {
            layout {
                row: 5;
                column: 0;
                column-span: 6;
            }
        }
    }
}
